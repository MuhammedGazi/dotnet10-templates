<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>ProjectApp-WebAPI-Dev</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <!-- AV0029/AV0030 (Asp.Versioning 10): sürüm başına ayrı OpenAPI belgesi için Asp.Versioning.OpenApi paketini önerir.
         Template tek sürümle (v1) çalışır, yerleşik /openapi/v1.json yeterlidir. İkinci bir API sürümü eklerken bu paketi ekleyip
         AddApiVersioning().AddOpenApi() + MapOpenApi().WithDocumentPerVersion() kullanın ve bu satırı kaldırın.
         (OpenAPI kaynak üreticisinin dosyalarında da çıktığı için .editorconfig yerine burada bastırılır.) -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ProjectApp.Application\ProjectApp.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\ProjectApp.Infrastructure\ProjectApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
